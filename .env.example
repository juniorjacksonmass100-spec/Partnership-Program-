# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# SUPABASE CONFIGURATION (SINGLE SOURCE OF TRUTH CLOUD DATABASE)
# =========================================================================
# Project URL from Supabase Project Settings > API (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=
VITE_SUPABASE_URL=

# Supabase Anonymous Public Key (Project Settings > API > anon public)
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (Project Settings > API > service_role secret)
# Required for server-side operations and secure administration
SUPABASE_SERVICE_ROLE_KEY=
